# 对外访问的完整 HTTPS 源地址（末尾不加斜杠，需与 Nginx 域名一致）
PUBLIC_ORIGIN=https://kui.example.com

# 宿主机本地监听端口（仅绑定 127.0.0.1，由 Nginx 反向代理）
KUI_PORT=8787

# 管理员账号配置（ADMIN_PASSWORD 必填，请使用独立强密码）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# 住宅代理凭据（仅启用住宅代理时需要，两项需同时设置且勿与管理员密码相同）
PROXY_USER=
PROXY_PASS=
PROXY_PUBLIC_LISTENER=false

# 可选：Telegram 告警通知
TG_BOT_TOKEN=
TG_CHAT_ID=
TG_WEBHOOK_SECRET=

# 可选：定时离线检查周期（毫秒，默认 300000 = 5 分钟）
# CRON_INTERVAL_MS=300000
