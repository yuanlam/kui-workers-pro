server {
    listen 80;
    listen [::]:80;
    server_name kui.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name kui.example.com;

    # 替换为你的实际证书路径（例如 certbot / acme.sh 签发的证书）
    ssl_certificate     /etc/letsencrypt/live/kui.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/kui.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    client_max_body_size 16m;

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;

        # WebSocket 支持（面板实时通道 + VPS Agent 长连接）
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header CF-Connecting-IP $remote_addr;

        # 保持 WebSocket 长连接不被 60s 默认超时切断
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }
}

# 若 nginx.conf 的 http {} 块中尚未定义 $connection_upgrade，请在 http {} 中加入：
# map $http_upgrade $connection_upgrade {
#     default upgrade;
#     ''      close;
# }
